# Original photos must live outside this repository and outside DATA_DIR.
PHOTOFLOW_NAS_ROOT=/absolute/path/to/nas/photos
PHOTOFLOW_DATA_DIR=./data
PHOTOFLOW_EXIFTOOL_PATH=exiftool
PHOTOFLOW_EXIFTOOL_TIMEOUT=30
PHOTOFLOW_THUMBNAIL_SIZE=400
PHOTOFLOW_THUMBNAIL_QUALITY=85
PHOTOFLOW_HOST=127.0.0.1
PHOTOFLOW_PORT=8000
